{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start All (Backend + Frontend)",
      "dependsOn": ["Start Backend", "Start Frontend"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend --reload",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend;${workspaceFolder};${workspaceFolder}/machine-learning/models"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
