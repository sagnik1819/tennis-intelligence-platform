{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--app-dir",
        "backend",
        "--reload"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend;${workspaceFolder};${workspaceFolder}/machine-learning/models"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
