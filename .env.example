# ==============================================================================
# TENNIS INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real keys. NEVER commit .env to GitHub.
# ==============================================================================

# SportRadar Tennis API
# Obtain free trial key at: https://developer.sportradar.com/
SPORTRADAR_API_KEY=your_sportradar_api_key_here
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_VERSION=v3
SPORTRADAR_LANGUAGE=en
SPORTRADAR_FORMAT=json

# Database (Leave empty for local SQLite, or paste Neon/Supabase PostgreSQL URL)
DATABASE_URL=

# Security (JWT)
JWT_SECRET_KEY=tennis-intelligence-super-secret-production-key-32-chars-long!

# ==============================================================================
# REAL GMAIL OTP VERIFICATION (100% Free - up to 500 emails/day via Gmail SMTP)
# How to get a free Gmail App Password:
#   1. Go to https://myaccount.google.com/security -> Enable 2-Step Verification
#   2. Go to https://myaccount.google.com/apppasswords -> Generate password for "Mail"
#   3. Paste your Gmail address & 16-character App Password below (without spaces)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ==============================================================================
# GOOGLE OAUTH 2.0 ("Continue with Google" - Free)
# How to get a free Google Client ID:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID (Web Application)
#   3. Add Authorized JavaScript origins: http://localhost:5173 and your Vercel URL
#   4. Paste the Client ID below AND in frontend/.env (VITE_GOOGLE_CLIENT_ID)
# ==============================================================================
GOOGLE_CLIENT_ID=

# ==============================================================================
# FREE PHONE NUMBER SMS OTP VERIFICATION
# Choose SMS_PROVIDER:
#   - textbelt : Built-in free tier gives 1 free SMS/day with key="textbelt" (no signup!)
#   - textbee  : Free Android SMS Gateway (300 free SMS/month via your Android phone SIM at textbee.dev)
#   - twilio   : Free trial credits at twilio.com/try-twilio
# ==============================================================================
SMS_PROVIDER=textbelt
TEXTBELT_API_KEY=textbelt
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sync Configuration
SYNC_CACHE_DIR=data-engineering/sample_data
