# ==============================================================================
# TENNIS INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real keys. NEVER commit .env to GitHub.
# ==============================================================================

# SportRadar Tennis API
# Obtain free trial key at: https://developer.sportradar.com/
SPORTRADAR_API_KEY=your_sportradar_api_key_here
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_VERSION=v3
SPORTRADAR_LANGUAGE=en
SPORTRADAR_FORMAT=json

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sync Configuration
SYNC_CACHE_DIR=data-engineering/sample_data
