# ==============================================================================
# TENNIS INTELLIGENCE PLATFORM - BACKEND DOCKERFILE
# Python 3.11 Slim Production Image
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency specifications
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend, sql, data-engineering, and ml directories
COPY backend/ ./backend/
COPY sql/ ./sql/
COPY data-engineering/ ./data-engineering/
COPY machine-learning/ ./machine-learning/

# Set Python path
ENV PYTHONPATH=/app/backend:/app/machine-learning/models:/app

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
